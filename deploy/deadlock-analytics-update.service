# Pull the newest image from GHCR and recreate the container if it changed.
# Option B in README "Deploy". Assumes the repo is checked out at /srv/deadlockanalytics
# by the `deadlock-deploy` user (in the docker group), which also holds the GHCR login if needed.
[Unit]
Description=Update Deadlock Analytics container
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=deadlock-deploy
WorkingDirectory=/srv/deadlockanalytics
ExecStart=/usr/bin/docker compose pull --quiet
ExecStart=/usr/bin/docker compose up -d --remove-orphans
