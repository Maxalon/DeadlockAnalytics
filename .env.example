# Tracked accounts, and the Steam bot's friend requests, are managed at /accounts in the UI.

# Optional deadlock-api.com key (sent as X-API-KEY). Not needed for a few accounts;
# it only raises rate limits.
DEADLOCK_API_KEY=

# The fetcher asks deadlock-api for match salts before spending its Steam bot's rate-limited
# quota on them. Set to 0 to only use the bot.
#SALTS_FROM_DEADLOCK_API=1

# Salts the bot fetches itself are given to deadlock-api in return (like its ingest tool does),
# so it has those matches too. Set to 0 to keep them to yourself.
#CONTRIBUTE_SALTS=1

# The bot's daily Steam budget (rolling 24 h). Only spent on request: re-pulling a player's
# history, or opening a match that has no details yet.
#BOT_SALTS_PER_DAY=40
#BOT_HISTORY_PAGES_PER_DAY=20

# How often tracked accounts are checked for new matches (seconds).
SYNC_INTERVAL_S=900

# Hero baselines: recomputed every BASELINE_INTERVAL_S from BASELINE_MAX_MATCHES matches
# spread over the last BASELINE_DAYS days (one slice per day).
BASELINE_INTERVAL_S=86400
BASELINE_DAYS=7
BASELINE_MAX_MATCHES=30000

# Where newly added accounts start backfilling (unix time). Default 2026-01-06,
# when Valve started reporting MVP ranks.
#BACKFILL_SINCE_UNIX=1767657600
