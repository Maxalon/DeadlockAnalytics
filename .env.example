# Accounts to track on first start, comma-separated. SteamID3 (e.g. 113956776) or SteamID64.
# More can be added (and removed) later at /accounts in the UI.
TRACKED_ACCOUNT_IDS=

# Steam bot fetcher: friend requests are accepted only from these accounts (SteamID3 or
# SteamID64). Defaults to TRACKED_ACCOUNT_IDS.
#FRIEND_ACCOUNT_IDS=

# Optional deadlock-api.com key (sent as X-API-KEY). Not needed for a few accounts;
# it only raises rate limits.
DEADLOCK_API_KEY=

# How often tracked accounts are checked for new matches (seconds).
SYNC_INTERVAL_S=900

# Hero baselines: recomputed every BASELINE_INTERVAL_S from BASELINE_MAX_MATCHES matches
# spread over the last BASELINE_DAYS days (one slice per day).
BASELINE_INTERVAL_S=86400
BASELINE_DAYS=7
BASELINE_MAX_MATCHES=30000

# Where newly added accounts start backfilling (unix time). Default 2026-01-06,
# when Valve started reporting MVP ranks.
#BACKFILL_SINCE_UNIX=1767657600
